{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"version": 2,
	"regions": ["fra1"],
	"outputDirectory": "public",
	"github": {
		"silent": true,
		"autoJobCancelation": true
	},
	"builds": [{ "src": "api/**/*.js", "use": "@vercel/node" }],
	"routes": [
		{ "src": "/api/(.*)", "dest": "/api/$1.js" },
		{ "src": "/(.*)", "dest": "/api/$1" }
	],
	"env": {
		"STRIPE_PRICE_ID": "price_1TIuNgQR8aaUqJtoydBY5Fmw"
	},
	"build": {
		"env": {
			"NOW_PHP_DEBUG": "1"
		}
	}
}
